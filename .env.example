# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms

# --- Auth ---
# demo : legacy in-browser demo accounts (no database required)
# db   : real authentication against the users table (production)
AUTH_MODE=demo
# Secret for signing session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# 주민등록번호 암호화 키 (개인정보보호법 제24조의2 · 시행령 제21조의2).
# 비워 두면 SESSION_SECRET 에서 파생하지만, 별도 키를 두는 편이 낫습니다 —
# 세션 키가 새도 주민번호는 바로 풀리지 않습니다.
#   openssl rand -hex 32
#
# 경고: 이 키를 잃어버리면 저장된 주민등록번호를 되살릴 수 없습니다.
# 백업 절차에 키 보관을 반드시 포함하세요.
RESIDENT_NUMBER_KEY=
# Session lifetime in hours
SESSION_TTL_HOURS=8

# --- Initial admin account (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator
