# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms

# --- Auth ---
# demo : legacy in-browser demo accounts (no database required)
# db   : real authentication against the users table (production)
AUTH_MODE=demo
# Secret for signing session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string
# Session lifetime in hours
SESSION_TTL_HOURS=8

# --- Initial admin account (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator
