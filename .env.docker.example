# 사내 서버 배포 설정 — 이 파일을 .env 로 복사해서 채웁니다.
#
#   copy .env.docker.example .env
#
# 자세한 절차는 docs/DEPLOY-INTERNAL.md 를 보세요.

# 데이터베이스 비밀번호 (컨테이너 안에서만 쓰이지만 강하게)
POSTGRES_PASSWORD=

# 세션 서명 키. 아래 명령으로 만듭니다:
#   powershell -Command "-join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})"
SESSION_SECRET=

# 주민등록번호 암호화 키 (개인정보보호법 제24조의2).
# 개발 PC에서 데이터를 옮겨 온다면 개발 PC .env.local 의 키를 그대로 쓰세요 —
# 키가 다르면 옮겨 온 주민번호를 복호화하지 못합니다.
# 잃어버리면 백업이 있어도 주민번호를 되살릴 수 없습니다. 반드시 따로 보관하세요.
RESIDENT_NUMBER_KEY=

# 최초 관리자 계정 (첫 시작 때 만들어집니다)
SEED_ADMIN_EMAIL=admin@daehan-at.co.kr
SEED_ADMIN_PASSWORD=

# 접속 포트 — 직원들은 http://서버IP:이포트 로 들어옵니다.
APP_PORT=3000

# 평가용 표본 조직을 넣을지 (운영에서는 false)
SEED_DEMO_DATA=false
